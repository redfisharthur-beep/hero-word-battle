    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zustand": "latest",
    "opencc-js": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@cloudflare/workers-types": "latest",
    "wrangler": "latest"
  }
}
